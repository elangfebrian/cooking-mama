# ===== Server =====
PORT=3000
NODE_ENV=development
# Origin yang boleh mengakses API (pisahkan dengan koma). "*" = semua (cukup untuk development).
CORS_ORIGIN=*
# Opsional: paksa base URL publik untuk URL foto upload (mis. https://api.contoh.com).
# Kosongkan agar otomatis memakai host dari request (cocok untuk emulator Android 10.0.2.2).
PUBLIC_BASE_URL=

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cooking_mama
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_postgres
# Set true bila memakai database cloud yang mewajibkan SSL (Supabase, Neon, dsb.)
DB_SSL=false

# ===== JWT =====
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_panjang
JWT_EXPIRES_IN=7d

# ===== Upload foto =====
MAX_UPLOAD_MB=5
